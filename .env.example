# Copy to root .env only if .env does not exist. Never overwrite existing values.
# Server-only secret. PLAN.md requires Potens as the only AI provider.
POTENS_API_KEY=""
# Optional server-controlled Potens model. Defaults to claude-4-6-sonnet.
POTENS_MODEL=""

# Legacy hosting setting; configure only if required by the actual environment.
APP_URL=""

# Browser-visible Supabase values. Never put a service-role/secret key in VITE_*.
VITE_SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Server only: create in the Thinkerbell Supabase project and Vercel server environment.
# Never use VITE_ or commit the real value.
SUPABASE_SECRET_KEY=""

# Fill only with the intended QA or production measurement ID for that environment.
# Analytics loads only after the visitor gives consent (PLAN.md).
VITE_GA4_ID=""
